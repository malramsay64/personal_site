# Response headers, read by both Cloudflare Workers static assets and Netlify.
# The strict CSP is applied to blog paths only; the WebAssembly/PyScript demos
# under /projects/<demo>/ load third-party code and only get the /* headers.
# The CSP placeholder is filled in at build time by scripts/csp.py (run by `just build`).

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

/
  Content-Security-Policy: __CSP__

/404.html
  Content-Security-Policy: __CSP__

/post/*
  Content-Security-Policy: __CSP__

/talks/*
  Content-Security-Policy: __CSP__

/publication/*
  Content-Security-Policy: __CSP__

/tags/*
  Content-Security-Policy: __CSP__

/projects/
  Content-Security-Policy: __CSP__
